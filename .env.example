# Copy to .env and adjust. Values here mirror app/settings.py defaults.

APP_ENV=dev
LOG_LEVEL=INFO

# Security
API_KEY=dev-api-key

# Inference
# DEVICE: auto | cpu | cuda   (auto = use GPU if available, else CPU)
DEVICE=auto
HF_MODEL_CACHE=/models
# TORCH_DTYPE: auto | float16 | float32  (float16 only used on CUDA)
TORCH_DTYPE=auto
# Max HF models kept resident before LRU eviction
MAX_LOADED_MODELS=8

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/translator

# Policies
RATE_LIMIT_RPM=60
CACHE_TTL_SECONDS=86400
MAX_SYNC_CHARS=6000
MAX_SYNC_TEXTS=64
MAX_JOB_TEXTS=2000

# When Redis is unavailable, allow requests through instead of failing closed
RATE_LIMIT_FAIL_OPEN=true

# HuggingFace (optional, improves download reliability)
# HUGGINGFACE_HUB_TOKEN=
